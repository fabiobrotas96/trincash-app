{
  "expo": {
    "name": "Trincash",
    "slug": "trincash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Permitir que o Trincash use o Face ID para desbloquear o app."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#0A0A0A",
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que o Trincash use o Face ID para desbloquear o app."
        }
      ]
    ]
  }
}
